# Python
.venv/
__pycache__/
*.pyc

# Secrets — never commit
.env
config.json

# Books: copyrighted EPUBs stay local
books/

# Per-book library: IR, voice maps, journals, renders (contains full book text)
library/

# Legacy flat output dir (pre-2026-06-10 layout; leftovers only)
output/

# Backup credentials + logs — never commit
.backup/

# macOS
.DS_Store

# Local Claude settings
.claude/settings.local.json

# Voice staging: the WAVs are disposable audition material (re-cut with
# scripts/stage_librivox_dialects.py); the provenance files ARE tracked.
librivox_voices/*.wav
vctk_voices/
.cache/

# Headless UI check screenshots — regenerable artifacts
tests/ui/*.png

# Piper voice models, downloaded into the repo root by SETUP.ps1 (and by the
# `python -m piper.download_voices …` lines the Setup page prints). Piper
# resolves `<name>.onnx` from the folder it is started in, which is why they
# live here rather than somewhere tidier. ~400 MB for the six.
*.onnx
*.onnx.json

# Written by SETUP.ps1 for the machine it ran on — the file a Windows user
# double-clicks. Generated, not authored.
start-prosecast.ps1
